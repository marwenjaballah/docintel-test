# Application Settings
DEBUG=true
CORS_ORIGINS=["*"]

# Authentication (Required - replace with your secret token)
API_KEY=your-secure-api-key-here

# LLM Configuration
LLM_PROVIDER=fake
LLM_LATENCY=0.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Required)
DATABASE_URL=postgresql+asyncpg://docintel:docintel@db:5432/docintel

# Redis / Celery Task Queue (Required)
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
